{
  "name": "saas-almacen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries && npm run format:check && npm test",
    "lint:boundaries": "node scripts/verify-boundaries.mjs",
    "postinstall": "prisma generate",
    "db:setup": "node scripts/db-setup.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "node scripts/db-check.mjs",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "verify:ui": "node scripts/verify-ui.mjs",
    "env:setup": "node scripts/env-setup.mjs",
    "setup": "npm run env:setup && npm run db:setup && npm run db:deploy"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "decimal.js": "10.6.0",
    "lucide-react": "1.50.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "mariadb": "3.4.7",
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
