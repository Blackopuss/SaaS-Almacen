{
  "name": "saas-almacen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:red": "node scripts/dev-lan.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries && npm run format:check && npm test",
    "lint:boundaries": "node scripts/verify-boundaries.mjs",
    "postinstall": "prisma generate",
    "db:setup": "node scripts/db-setup.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "node scripts/db-check.mjs",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "verify:ui": "node scripts/verify-ui.mjs",
    "env:setup": "node scripts/env-setup.mjs",
    "setup": "npm run env:setup && npm run db:setup && npm run db:deploy",
    "db:seed": "tsx --conditions=react-server scripts/seed-dev.mts",
    "demo:codigo": "node scripts/demo-code.mjs",
    "staff": "tsx --conditions=react-server scripts/staff.mts",
    "dev:test": "node scripts/dev-test.mjs",
    "test:company": "tsx --conditions=react-server scripts/test-company.mts",
    "stock:reconcile": "tsx --conditions=react-server scripts/stock-reconcile.mts",
    "worker": "tsx scripts/worker.mts",
    "correo:prueba": "tsx --conditions=react-server scripts/mail-test.mts",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "load:test": "tsx scripts/load-test.mts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "animejs": "4.5.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "decimal.js": "10.6.0",
    "lucide-react": "1.50.0",
    "motion": "14.0.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "uqr": "0.1.3",
    "uuid": "14.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2",
    "handlebars": "4.7.10"
  }
}
