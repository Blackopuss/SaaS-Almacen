// Database schema. Models are added step by step (PLT-01 onwards).
// Every business table carries organization_id (see AGENTS.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ── Identity (Better Auth core tables, BAS-04) ───────────────────────────
// IDs are UUIDv7 generated by the app (src/lib/ids.ts).

model User {
  id               String         @id @db.Char(36)
  name             String         @db.VarChar(120)
  email            String         @unique @db.VarChar(254)
  emailVerified    Boolean        @default(false)
  /// Set by Better Auth once a TOTP app is verified (PLT-08A).
  twoFactorEnabled Boolean        @default(false)
  image            String?        @db.Text
  createdAt        DateTime       @default(now()) @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @db.DateTime(3)
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
  memberships      Membership[]
  ownedOrgs        Organization[] @relation("OrganizationOwner")
  platformStaff    PlatformStaff?

  @@map("user")
}

model Session {
  id                   String        @id @db.Char(36)
  expiresAt            DateTime      @db.DateTime(3)
  token                String        @unique @db.VarChar(255)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)
  ipAddress            String?       @db.VarChar(64)
  userAgent            String?       @db.Text
  userId               String        @db.Char(36)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Company this session works in (PLT-11). Re-checked against an active
  /// membership on every request; never trusted on its own.
  activeOrganizationId String?       @db.Char(36)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id @db.Char(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.Char(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.Char(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("verification")
}

/// TOTP secret and backup codes (Better Auth two-factor plugin, PLT-08A).
/// Both are encrypted with BETTER_AUTH_SECRET; `verified` stays false until
/// the first code from the app is confirmed.
model TwoFactor {
  id                      String    @id @db.Char(36)
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String    @unique @db.Char(36)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.DateTime(3)

  @@map("twoFactor")
}

// ── Tenancy (PLT-01) ──────────────────────────────────────────────────────
// Every business table will reference organization_id. Deletes never
// cascade across tenants: removing data is an explicit, audited process.

model Organization {
  id                         String                      @id @db.Char(36)
  name                       String                      @db.VarChar(120)
  timeZone                   String                      @default("America/Mexico_City") @db.VarChar(64)
  currency                   String                      @default("MXN") @db.Char(3)
  /// Titular: the only account allowed to contract or cancel (USR-03).
  ownerUserId                String                      @db.Char(36)
  owner                      User                        @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdAt                  DateTime                    @default(now()) @db.DateTime(3)
  updatedAt                  DateTime                    @updatedAt @db.DateTime(3)
  memberships                Membership[]
  memberRoles                MembershipRole[]
  sessions                   Session[]
  auditEvents                AuditEvent[]
  ownershipTransfers         OwnershipTransfer[]
  invitations                Invitation[]
  subscriptions              Subscription[]
  subscriptionItems          SubscriptionItem[]
  entitlements               Entitlement[]
  quotaUsages                QuotaUsage[]
  products                   Product[]
  productCategories          ProductCategory[]
  productBrands              ProductBrand[]
  productPresentations       ProductPresentation[]
  presentationVersions       PresentationVersion[]
  facilities                 Facility[]
  locations                  Location[]
  stockMovements             StockMovement[]
  stockMovementLines         StockMovementLine[]
  stockBalances              StockBalance[]
  stockMinimums              StockMinimum[]
  productCosts               ProductCost[]
  salePrices                 SalePrice[]
  salesSettings              SalesSettings?
  stockCounts                StockCount[]
  stockCountLines            StockCountLine[]
  stockCountCaptures         StockCountCapture[]
  jobs                       Job[]
  storedFiles                StoredFile[]
  productImports             ProductImport[]
  productImportItems         ProductImportItem[]
  exitImports                ExitImport[]
  exitImportRows             ExitImportRow[]
  contacts                   Contact[]
  productSuppliers           ProductSupplier[]
  purchaseOrders             PurchaseOrder[]
  purchaseOrderLines         PurchaseOrderLine[]
  purchaseOrderDeliveries    PurchaseOrderDelivery[]
  purchaseReceipts           PurchaseReceipt[]
  purchaseReceiptLines       PurchaseReceiptLine[]
  purchaseReturns            PurchaseReturn[]
  purchaseReturnLines        PurchaseReturnLine[]
  manualPayments             ManualPayment[]
  checkoutOrders             CheckoutOrder[]
  supportAccesses            SupportAccess[]
  sales                      Sale[]
  saleLines                  SaleLine[]
  salePayments               SalePayment[]
  saleDiscountAuthorizations SaleDiscountAuthorization[]
  cashSessions               CashSession[]
  cashMovements              CashMovement[]
  saleReturns                SaleReturn[]
  saleReturnLines            SaleReturnLine[]
  salesQuotes                SalesQuote[]
  salesQuoteLines            SalesQuoteLine[]
  salesQuoteDeliveries       SalesQuoteDelivery[]
  salesOrders                SalesOrder[]
  salesOrderLines            SalesOrderLine[]

  @@index([ownerUserId])
  @@map("organization")
}

// Shared physical space (INV-13). V1 has one facility per company;
// multi-facility operation requires an explicit future migration.
model Facility {
  id             String       @id @db.Char(36)
  organizationId String       @unique @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(120)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  locations      Location[]

  @@unique([organizationId, id])
  @@map("facility")
}

/// What a location is (INV-14). The order is the hierarchy: a zone holds
/// aisles and shelves, an aisle holds shelves, a shelf holds nothing.
/// Levels are optional (a shelf may hang directly from the facility), but a
/// location only goes inside a coarser one, so a cycle cannot be built.
enum LocationKind {
  /// The default location of the facility; always at the root, no children.
  GENERAL
  ZONE
  AISLE
  SHELF
}

model Location {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityId      String                @db.Char(36)
  facility        Facility              @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict)
  /// Name given by the business; unique among the locations of its parent.
  name            String                @db.VarChar(120)
  /// Fixed when the location is created (trigger).
  kind            LocationKind
  /// Location that contains this one, in the same facility; NULL = root.
  parentId        String?               @db.Char(36)
  parent          Location?             @relation("LocationTree", fields: [organizationId, facilityId, parentId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  children        Location[]            @relation("LocationTree")
  movementLines   StockMovementLine[]
  balances        StockBalance[]
  counts          StockCount[]
  exitImportRows  ExitImportRow[]
  receiptLines    PurchaseReceiptLine[]
  returnLines     PurchaseReturnLine[]
  saleLines       SaleLine[]
  saleReturnLines SaleReturnLine[]
  /// True for General, NULL for other locations (never false; SQL CHECK).
  /// MySQL allows multiple NULLs in the unique key, but only one true.
  isDefault       Boolean?
  /// Archived locations stay for the history; nothing is deleted.
  archivedAt      DateTime?             @db.DateTime(3)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, facilityId, id])
  /// Names repeat under different parents ("Estante 1" in two aisles). At
  /// the root parentId is NULL and MySQL would not compare: a trigger does.
  @@unique([organizationId, facilityId, parentId, name])
  @@unique([organizationId, facilityId, isDefault])
  @@map("location")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id              String              @id @db.Char(36)
  organizationId  String              @db.Char(36)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId          String              @db.Char(36)
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          MembershipStatus    @default(ACTIVE)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)
  roles           MembershipRole[]
  ownershipOffers OwnershipTransfer[]

  @@unique([organizationId, userId])
  /// Target of company-scoped foreign keys (PLT-13).
  @@unique([organizationId, id])
  @@index([userId])
  @@map("membership")
}

/// Roles of a member (USR-01/USR-06). Values come from the role catalog in
/// code once the matrix is approved (FUN-07). The composite foreign key
/// includes organizationId, so a role can never point to a membership of
/// another company (PLT-13).
model MembershipRole {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipId   String       @db.Char(36)
  membership     Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role           String       @db.VarChar(40)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([membershipId, role])
  @@index([organizationId, membershipId])
  @@map("membership_role")
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// Offer to hand the company over to another member (USR-03B). The titular
/// offers, the recipient accepts; only then Organization.ownerUserId
/// changes, in one transaction. At most one PENDING offer per company
/// (checked under a lock on the organization row).
model OwnershipTransfer {
  id                 String                  @id @db.Char(36)
  organizationId     String                  @db.Char(36)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Titular who made the offer.
  fromUserId         String                  @db.Char(36)
  /// Membership of the person who would become titular.
  toMembershipId     String                  @db.Char(36)
  toMembership       Membership              @relation(fields: [organizationId, toMembershipId], references: [organizationId, id], onDelete: Cascade)
  /// Roles the previous titular keeps afterwards (chosen by them).
  previousOwnerRoles Json
  status             OwnershipTransferStatus @default(PENDING)
  expiresAt          DateTime                @db.DateTime(3)
  createdAt          DateTime                @default(now()) @db.DateTime(3)
  resolvedAt         DateTime?               @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, toMembershipId])
  @@map("ownership_transfer")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// Invitation to join a company with roles already chosen (USR-04). The
/// link carries a random token; only its SHA-256 is stored. It works once
/// and expires. The titular is never invited: roles come from the catalog.
model Invitation {
  id              String           @id @db.Char(36)
  organizationId  String           @db.Char(36)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Normalized (trimmed, lower case) address the link was sent to.
  email           String           @db.VarChar(254)
  tokenHash       String           @unique @db.Char(64)
  roles           Json
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @db.Char(36)
  expiresAt       DateTime         @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  resolvedAt      DateTime?        @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("invitation")
}

// ── Brute-force protection (PLT-06) ──────────────────────────────────────

/// Attempt counters for sign-in, registration and verification emails.
/// Keys never contain raw emails (SHA-256 of the normalized address).
model AuthThrottle {
  key          String    @id @db.VarChar(191)
  count        Int
  windowStart  DateTime  @db.DateTime(3)
  blockedUntil DateTime? @db.DateTime(3)

  @@index([windowStart])
  @@map("auth_throttle")
}

/// Better Auth's own limiter for the /api/auth HTTP endpoints.
model RateLimit {
  id          String @id @db.Char(36)
  key         String @unique @db.VarChar(191)
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ── Audit log (PLT-14) ───────────────────────────────────────────────────
// Append-only: database triggers reject UPDATE and DELETE for every user.
// Metadata is sanitized before it is stored (no passwords, tokens or codes).

/// Sensitive changes inside a company: who, what, on which record and why.
model AuditEvent {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Null for changes made by the system. No foreign key: the history
  /// outlives accounts.
  actorUserId    String?      @db.Char(36)
  action         String       @db.VarChar(80)
  targetType     String?      @db.VarChar(40)
  targetId       String?      @db.VarChar(64)
  reason         String?      @db.VarChar(500)
  metadata       Json?
  ipAddress      String?      @db.VarChar(64)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, targetType, targetId])
  @@map("audit_event")
}

/// Account security events (password, MFA, sessions), not tied to a company.
model SecurityEvent {
  id        String   @id @db.Char(36)
  /// No foreign key: the history outlives accounts.
  userId    String   @db.Char(36)
  action    String   @db.VarChar(80)
  metadata  Json?
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([userId, createdAt])
  @@map("security_event")
}

/// One person accepted one version of a legal document (PIL-09): terms of
/// service or privacy notice. Per person, not per company (the documents
/// are accepted once for the account), so it is not a tenant model. No
/// foreign key and append-only (triggers), like security_event: the proof
/// outlives accounts and is never edited.
model LegalAcceptance {
  id         String   @id @db.Char(36)
  userId     String   @db.Char(36)
  /// "terms" or "privacy" (LEGAL_DOCUMENTS in src/platform/legal).
  document   String   @db.VarChar(20)
  version    String   @db.VarChar(20)
  acceptedAt DateTime @default(now()) @db.DateTime(3)
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)

  @@unique([userId, document, version])
  @@map("legal_acceptance")
}

// ── Commercial model (MOD-03) ────────────────────────────────────────────

/// One published set of conditions for a capacity tier: product quota,
/// included users and prices. Never edited once a company contracted it:
/// a change of price or limit is a new version, so existing subscriptions
/// keep the conditions they accepted.
model PlanVersion {
  id             String            @id @db.Char(36)
  /// Capacity tier, e.g. "t1000" (1,000 active products).
  tier           String            @db.VarChar(20)
  version        Int
  name           String            @db.VarChar(80)
  productLimit   Int
  includedUsers  Int
  currency       String            @default("MXN") @db.Char(3)
  /// Monthly price of each additional user, before taxes.
  extraUserPrice Decimal           @db.Decimal(12, 2)
  effectiveFrom  DateTime          @db.DateTime(3)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  modulePrices   PlanModulePrice[]
  subscriptions  Subscription[]
  offers         PlanOffer[]

  @@unique([tier, version])
  @@map("plan_version")
}

/// Which version of a tier is offered to new customers today. Publishing
/// a new price moves this pointer; the versions themselves never change.
model PlanOffer {
  tier          String      @id @db.VarChar(20)
  planVersionId String      @db.Char(36)
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)

  @@map("plan_offer")
}

/// Monthly price of a module in a plan version, before taxes.
model PlanModulePrice {
  id            String      @id @db.Char(36)
  planVersionId String      @db.Char(36)
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  /// Module id from the registry (src/modules/registry).
  moduleId      String      @db.VarChar(40)
  monthlyPrice  Decimal     @db.Decimal(12, 2)

  @@unique([planVersionId, moduleId])
  @@map("plan_module_price")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
}

/// What a company contracted: one plan version, its period and extra
/// users. One per company.
model Subscription {
  id                 String             @id @db.Char(36)
  organizationId     String             @unique @db.Char(36)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planVersionId      String             @db.Char(36)
  planVersion        PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(TRIAL)
  extraUsers         Int                @default(0)
  currentPeriodStart DateTime           @db.DateTime(3)
  currentPeriodEnd   DateTime           @db.DateTime(3)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)
  items              SubscriptionItem[]
  entitlements       Entitlement[]

  @@unique([organizationId, id])
  @@index([planVersionId])
  @@map("subscription")
}

/// A module inside a subscription, with the price agreed when it was added.
model SubscriptionItem {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptionId String       @db.Char(36)
  subscription   Subscription @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Cascade)
  moduleId       String       @db.VarChar(40)
  monthlyPrice   Decimal      @db.Decimal(12, 2)
  activeFrom     DateTime     @db.DateTime(3)
  /// Null while active; set when the module is removed.
  activeUntil    DateTime?    @db.DateTime(3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([subscriptionId, moduleId])
  @@map("subscription_item")
}

enum EntitlementKind {
  MODULE
  LIMIT
}

/// What a company may use right now: a module, or a limit with its value.
/// The server guard reads only this table (MOD-04/05); it is written from
/// the subscription or by platform staff (MOD-09), never by the customer.
model Entitlement {
  id             String          @id @db.Char(36)
  organizationId String          @db.Char(36)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind           EntitlementKind
  /// Module id, or limit key such as "active_products" or "users".
  key            String          @db.VarChar(40)
  /// Value of a limit; null for modules.
  value          Int?
  validFrom      DateTime        @db.DateTime(3)
  /// Null = no end date.
  validUntil     DateTime?       @db.DateTime(3)
  /// Subscription it comes from; null when granted by platform staff.
  subscriptionId String?         @db.Char(36)
  subscription   Subscription?   @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict)
  createdAt      DateTime        @default(now()) @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, kind, key])
  @@map("entitlement")
}

/// How much of a plan limit a company is using (MOD-07). `taken` counts
/// what exists plus what is reserved (e.g. by an import in progress), so
/// one conditional UPDATE decides whether something fits: two requests for
/// the last place cannot both win.
model QuotaUsage {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Limit key of the entitlement: "active_products", "users".
  key            String       @db.VarChar(40)
  /// In use + reserved.
  taken          Int          @default(0)
  /// Part of `taken` that is only reserved.
  reserved       Int          @default(0)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("quota_usage")
}

// ── Platform staff (MOD-09) ──────────────────────────────────────────────

/// People of our own team who may use the internal console (assign plans
/// and modules to any company). Rows are written only with
/// `npm run staff -- add <correo>` by someone with database access; there
/// is no screen to grant it. MFA is mandatory for them.
model PlatformStaff {
  userId     String    @id @db.Char(36)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  /// Set when access is withdrawn; the row stays as a record.
  disabledAt DateTime? @db.DateTime(3)

  @@map("platform_staff")
}

// ── Online purchase (ADR 0028) ───────────────────────────────────────────

enum CheckoutProvider {
  STRIPE
  PAYPAL
  MERCADOPAGO
  /// Paid entirely with a code (100% off): no provider involved.
  CODE
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// A plan bought online by the owner of a company. Every amount is fixed
/// by the server when the order is created (src/platform/billing/prices);
/// the provider only confirms that exactly that was paid. The plan is
/// applied once, when the order becomes PAID.
model CheckoutOrder {
  id               String           @id @db.Char(36)
  organizationId   String           @db.Char(36)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Shown to the customer and in the email: "AL-7F3K9Q2M".
  transactionId    String           @unique @db.VarChar(20)
  /// Owner who bought it.
  userId           String           @db.Char(36)
  tier             String           @db.VarChar(20)
  productLimit     Int
  includedUsers    Int
  /// Modules bought, comma separated in registry order: "inventory,purchasing".
  modules          String           @db.VarChar(200)
  months           Int
  subtotal         Decimal          @db.Decimal(12, 2)
  discount         Decimal          @db.Decimal(12, 2)
  tax              Decimal          @db.Decimal(12, 2)
  total            Decimal          @db.Decimal(12, 2)
  currency         String           @default("MXN") @db.Char(3)
  provider         CheckoutProvider
  /// The provider's checkout id (session / order / preference).
  providerRef      String?          @db.VarChar(255)
  /// The provider's id of the captured payment.
  paymentRef       String?          @db.VarChar(255)
  status           CheckoutStatus   @default(PENDING)
  promoCodeId      String?          @db.Char(36)
  promoCode        PromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  /// End of the plan before and after applying this purchase.
  validUntilBefore DateTime?        @db.DateTime(3)
  validUntilAfter  DateTime?        @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  /// After this a PENDING order is no longer payable.
  expiresAt        DateTime         @db.DateTime(3)
  paidAt           DateTime?        @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([provider, providerRef])
  @@index([organizationId, createdAt])
  @@index([status, expiresAt])
  @@map("checkout_order")
}

/// A discount code created by platform staff (/interno/codigos). Not a
/// company table: one code can be used by different companies.
model PromoCode {
  id              String          @id @db.Char(36)
  /// Upper case, letters, digits and hyphens: "PEPITOGRATIS".
  code            String          @unique @db.VarChar(40)
  /// Whole percentage taken from the subtotal; 100 = free.
  percentOff      Int
  maxRedemptions  Int
  /// Orders PAID with it; moved with a conditional UPDATE (never > max).
  redemptions     Int             @default(0)
  validUntil      DateTime?       @db.DateTime(3)
  disabledAt      DateTime?       @db.DateTime(3)
  note            String?         @db.VarChar(200)
  createdByUserId String          @db.Char(36)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  orders          CheckoutOrder[]

  @@map("promo_code")
}

/// A webhook received from a provider, stored before answering so a
/// repeated delivery is recognised (unique per provider + event id). The
/// body is not stored: the state is always asked to the provider.
model PaymentEvent {
  id          String    @id @db.Char(36)
  provider    String    @db.VarChar(20)
  eventId     String    @db.VarChar(255)
  type        String    @db.VarChar(100)
  orderId     String?   @db.Char(36)
  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)

  @@unique([provider, eventId])
  @@map("payment_event")
}

enum ManualPaymentKind {
  PAYMENT
  REVERSAL
}

/// A bank transfer (SPEI) registered by platform staff while billing is
/// assisted (PIL-11, ADR 0027). Registering it moves the end of the plan
/// (`validUntilBefore` → `validUntilAfter`). Immutable (triggers): a
/// mistake is undone by a REVERSAL row pointing to the payment, which
/// takes the same months back.
model ManualPayment {
  id                String            @id @db.Char(36)
  organizationId    String            @db.Char(36)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind              ManualPaymentKind @default(PAYMENT)
  /// Amount received, MXN; a reversal repeats the amount of its payment.
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("MXN") @db.Char(3)
  /// Day of the transfer, as written on the bank receipt.
  paidOn            DateTime          @db.Date
  /// SPEI tracking key (clave de rastreo), upper case; null in reversals.
  reference         String?           @db.VarChar(40)
  /// Months of plan it pays (or takes back).
  months            Int
  /// Free notes; reason of a reversal. Fiscal data (CFDI) comes later (PIL-10).
  notes             String?           @db.VarChar(500)
  reversesPaymentId String?           @db.Char(36)
  reverses          ManualPayment?    @relation("ManualPaymentReversal", fields: [organizationId, reversesPaymentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reversal          ManualPayment?    @relation("ManualPaymentReversal")
  validUntilBefore  DateTime          @db.DateTime(3)
  validUntilAfter   DateTime          @db.DateTime(3)
  recordedByUserId  String            @db.Char(36)
  createdAt         DateTime          @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  /// One reversal per payment.
  @@unique([organizationId, reversesPaymentId])
  @@index([organizationId, reference])
  @@index([organizationId, createdAt])
  @@map("manual_payment")
}

/// Temporary, read-only access of platform support to a company (PIL-12).
/// The titular opens it for a fixed time and may close it earlier; nothing
/// is ever deleted, so it stays as the record of who allowed what and when.
model SupportAccess {
  id              String       @id @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grantedByUserId String       @db.Char(36)
  expiresAt       DateTime     @db.DateTime(3)
  revokedAt       DateTime?    @db.DateTime(3)
  revokedByUserId String?      @db.Char(36)
  createdAt       DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, expiresAt])
  @@map("support_access")
}

// ── Product catalog (INV-01) ─────────────────────────────────────────────
// The catalog belongs to the shared core (platform/catalog): Inventario,
// Compras and later Ventas use the same products. Text columns use the
// database's case- and accent-insensitive collation, so "tor-001" and
// "TOR-001" are the same SKU.

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// Grouping chosen by the business: "Tornillería", "Pinturas".
model ProductCategory {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(80)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("product_category")
}

model ProductBrand {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(80)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("product_brand")
}

/// One thing the business keeps in stock. Quantities never live here:
/// stock is the sum of movements (INV-15). An active product takes one
/// place of the plan's quota; an archived one does not.
model Product {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Code the business uses for the product; unique in the company.
  sku             String                @db.VarChar(64)
  name            String                @db.VarChar(160)
  description     String?               @db.Text
  categoryId      String?               @db.Char(36)
  category        ProductCategory?      @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  brandId         String?               @db.Char(36)
  brand           ProductBrand?         @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  /// Printed code read by a scanner; unique in the company when present.
  barcode         String?               @db.VarChar(64)
  /// Unit in which the product is controlled (INV-06). Stock is always
  /// kept in this unit; presentations convert to it.
  unitCode        String                @default("piece") @db.VarChar(12)
  unit            Unit                  @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  /// Increment accepted for quantities: 1 = whole units, 0.01 = hundredths.
  quantityStep    Decimal               @default(1) @db.Decimal(12, 3)
  presentations   ProductPresentation[]
  movementLines   StockMovementLine[]
  balances        StockBalance[]
  minimum         StockMinimum?
  countLines      StockCountLine[]
  exitImportRows  ExitImportRow[]
  suppliers       ProductSupplier[]
  orderLines      PurchaseOrderLine[]
  receiptLines    PurchaseReceiptLine[]
  returnLines     PurchaseReturnLine[]
  cost            ProductCost?
  salePrices      SalePrice[]
  saleLines       SaleLine[]
  saleReturnLines SaleReturnLine[]
  quoteLines      SalesQuoteLine[]
  salesOrderLines SalesOrderLine[]
  status          ProductStatus         @default(ACTIVE)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  /// List and search (INV-10/11): the order by name and the three searched
  /// columns live in one index, so a search never reads the whole table.
  @@index([organizationId, status, name, sku, barcode])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
  @@map("product")
}

// ── Units of measure (INV-05) ────────────────────────────────────────────

/// Fixed catalog shared by every company, seeded by migration from
/// src/platform/catalog/units.ts (a test keeps both equal). Reference
/// data: it has no company and is never emptied by the test setup.
model Unit {
  code        String    @id @db.VarChar(12)
  /// count, mass, length, volume or area.
  dimension   String    @db.VarChar(12)
  name        String    @db.VarChar(40)
  plural      String    @db.VarChar(40)
  symbol      String    @db.VarChar(8)
  /// Reference units of its dimension in one of this unit.
  toReference Decimal   @db.Decimal(18, 9)
  fractional  Boolean
  products    Product[]

  capturedLines StockMovementLine[] @relation("LineCapturedUnit")
  movementLines StockMovementLine[] @relation("LineUnit")

  @@map("unit")
}

// ── Presentations (INV-07, INV-08) ───────────────────────────────────────

/// How a product is bought or handled besides its unit: "Caja", "Rollo",
/// "Saco". Each company defines them per product; the name alone says
/// nothing about the content.
model ProductPresentation {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String                @db.Char(36)
  product         Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  name            String                @db.VarChar(40)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  versions        PresentationVersion[]
  movementLines   StockMovementLine[]
  countCaptures   StockCountCapture[]
  purchasedAs     ProductSupplier[]
  orderLines      PurchaseOrderLine[]
  receiptLines    PurchaseReceiptLine[]
  salePrices      SalePrice[]
  saleLines       SaleLine[]
  saleReturnLines SaleReturnLine[]
  quoteLines      SalesQuoteLine[]
  salesOrderLines SalesOrderLine[]

  @@unique([organizationId, id])
  /// Lets a movement line prove its presentation is of its product.
  @@unique([organizationId, productId, id])
  @@unique([organizationId, productId, name])
  @@map("product_presentation")
}

/// Content of a presentation in the product's unit ("100 piezas"), as it
/// was from a moment on. A change of content is a new version; movements
/// keep the version they used, so history never changes (INV-08).
model PresentationVersion {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  presentationId  String                @db.Char(36)
  presentation    ProductPresentation   @relation(fields: [organizationId, presentationId], references: [organizationId, id], onDelete: Restrict)
  version         Int
  /// Units of the product in one presentation.
  factor          Decimal               @db.Decimal(18, 3)
  createdByUserId String                @db.Char(36)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  movementLines   StockMovementLine[]
  countCaptures   StockCountCapture[]
  lastCostOf      ProductSupplier[]
  orderLines      PurchaseOrderLine[]
  receiptLines    PurchaseReceiptLine[]
  saleLines       SaleLine[]
  saleReturnLines SaleReturnLine[]
  quoteLines      SalesQuoteLine[]
  salesOrderLines SalesOrderLine[]

  @@unique([organizationId, id])
  /// Lets a movement line prove its version is of its presentation.
  @@unique([organizationId, presentationId, id])
  @@unique([presentationId, version])
  @@map("presentation_version")
}

// ── Stock: movements, lines and balances (INV-15) ────────────────────────

/// What a movement is. Later steps add their own kinds (receptions,
/// counts) with a migration.
enum StockMovementType {
  /// Stock that arrives (INV-16/17).
  ENTRY
  /// Stock that leaves (INV-19, INV-28).
  EXIT
  /// From one location to another, both sides in one movement (INV-23).
  TRANSFER
  /// Correction with a mandatory reason (INV-24).
  ADJUSTMENT
  /// What there was when the business started using the system (INV-18).
  INITIAL
  /// Undoes another movement with its original quantities (INV-25).
  REVERSAL
  /// Goods of a purchase order that arrived (CMP-07): written by the
  /// receipt, in its transaction, and corrected only from Compras.
  RECEIPT
  /// Goods received and sent back to the supplier (CMP-12): written by
  /// the return, in its transaction; never reversed from Inventario.
  RETURN
  /// Goods sold at the counter (VEN-09): written by the sale, in its
  /// transaction; corrected only from Ventas (return or cancellation).
  SALE
  /// Goods of a sale that came back (VEN-19): written by the return, in
  /// its transaction, at the cost they left with.
  SALE_RETURN
}

enum StockDirection {
  IN
  OUT
}

/// One confirmed change of stock: who, when, why and its lines. Confirmed
/// movements never change and are never deleted (triggers); a mistake is
/// corrected with a reversal.
model StockMovement {
  id                 String              @id @db.Char(36)
  organizationId     String              @db.Char(36)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type               StockMovementType
  /// Why it was made; mandatory for some kinds (adjustments, reversals).
  reason             String?             @db.VarChar(500)
  /// Document or note of the business: a ticket, a delivery note.
  reference          String?             @db.VarChar(120)
  /// Sent with the confirmation so that repeating it never duplicates the
  /// movement (INV-21). Unique in the company when present.
  idempotencyKey     String?             @db.VarChar(64)
  /// Movement this one undoes; a movement is reversed at most once.
  reversesMovementId String?             @db.Char(36)
  reverses           StockMovement?      @relation("StockReversal", fields: [organizationId, reversesMovementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy         StockMovement?      @relation("StockReversal")
  /// Person who confirmed it (an account; not a company row).
  createdByUserId    String              @db.Char(36)
  createdAt          DateTime            @default(now()) @db.DateTime(3)
  lines              StockMovementLine[]
  appliedCount       StockCount?
  purchaseReceipt    PurchaseReceipt?
  purchaseReturn     PurchaseReturn?
  sale               Sale?
  saleReturn         SaleReturn?

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, reversesMovementId])
  @@index([organizationId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, createdByUserId, createdAt])
  @@map("stock_movement")
}

/// One product in one location, in or out. It keeps what the person
/// captured, the factor applied, the presentation version it came from and
/// the resulting quantity in the product's unit, which is what moves stock:
///
///   baseQuantity = capturedQuantity × factor   (CHECK, exact decimals)
///
/// Changing a presentation later never changes these numbers.
model StockMovementLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  movementId            String               @db.Char(36)
  movement              StockMovement        @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  locationId            String               @db.Char(36)
  location              Location             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  direction             StockDirection
  /// As captured: "3" (boxes), "275" (centimeters), "25" (pieces).
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  /// Unit of the capture when it was another unit of the same dimension.
  capturedUnitCode      String?              @db.VarChar(12)
  capturedUnit          Unit?                @relation("LineCapturedUnit", fields: [capturedUnitCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  /// Presentation captured, with the version whose content was applied.
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Multiplier applied; 1 when captured in the product's unit.
  factor                Decimal              @db.Decimal(18, 6)
  /// Quantity in the product's unit: what was added to or taken from stock.
  baseQuantity          Decimal              @db.Decimal(12, 3)
  /// Unit of the product when it moved (fixed after its first movement).
  unitCode              String               @db.VarChar(12)
  unit                  Unit                 @relation("LineUnit", fields: [unitCode], references: [code], onDelete: Restrict)
  /// Cost of one unit of the product this line was valued at, before taxes
  /// (VAL-01, ADR 0031): the cost of an entry, or the average cost an exit
  /// took. Null when the product had no known cost.
  unitCost              Decimal?             @db.Decimal(18, 6)
  createdAt             DateTime             @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, movementId, lineNumber])
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, locationId, createdAt])
  @@map("stock_movement_line")
}

/// How much of a product there is in a location, in the product's unit.
/// It is the sum of the lines (IN − OUT), kept up to date in the same
/// transaction as each movement so that reading stock is one row. Never
/// negative (CHECK) and never edited from a screen.
model StockBalance {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String       @db.Char(36)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  locationId     String       @db.Char(36)
  location       Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(18, 3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, locationId])
  @@index([organizationId, locationId])
  @@map("stock_balance")
}

/// Average cost of a product (VAL-01, ADR 0031): the value of all its stock
/// and the price of one unit of the product, before taxes, kept up to date
/// in the same transaction as each movement (src/modules/inventory/
/// average-cost.ts). A table of its own so that cost is only read on
/// purpose, by whoever may see costs. No row while the cost is unknown.
model ProductCost {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String       @db.Char(36)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  averageCost    Decimal      @db.Decimal(18, 6)
  stockValue     Decimal      @db.Decimal(20, 6)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId])
  @@map("product_cost")
}

/// Lowest stock a company wants of a product, in the product's unit
/// (INV-30). At or below it the product shows up as low. One per product;
/// removing the minimum deletes the row.
model StockMinimum {
  id              String       @id @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String       @db.Char(36)
  product         Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  quantity        Decimal      @db.Decimal(18, 3)
  /// Person who set it last (an account; not a company row).
  updatedByUserId String       @db.Char(36)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId])
  @@map("stock_minimum")
}

enum StockCountStatus {
  /// Being captured.
  OPEN
  /// Its differences were written as adjustments (INV-33); immutable.
  APPLIED
  /// Abandoned without changing stock.
  CANCELLED
}

/// A physical count of one location (INV-31): people write down what
/// they find; the system compares it with its balance. Capturing never
/// changes stock: only applying the count does (INV-33).
model StockCount {
  id                String           @id @db.Char(36)
  organizationId    String           @db.Char(36)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId        String           @db.Char(36)
  location          Location         @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  status            StockCountStatus @default(OPEN)
  /// The location while the count is open, null afterwards: the unique
  /// index below allows one open count per location.
  openLocationId    String?          @db.Char(36)
  note              String?          @db.VarChar(200)
  startedAt         DateTime         @default(now()) @db.DateTime(3)
  startedByUserId   String           @db.Char(36)
  closedAt          DateTime?        @db.DateTime(3)
  closedByUserId    String?          @db.Char(36)
  /// The adjustment that applied its differences (INV-33); null when it
  /// was applied without differences, cancelled or still open.
  appliedMovementId String?          @db.Char(36)
  appliedMovement   StockMovement?   @relation(fields: [organizationId, appliedMovementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lines             StockCountLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, openLocationId])
  @@unique([organizationId, appliedMovementId])
  @@index([organizationId, status, startedAt])
  @@map("stock_count")
}

/// One product in a count. It keeps the reference of the comparison: the
/// moment the product was first counted and the balance the system had
/// then. Movements after that moment are not part of what was counted
/// (INV-32).
model StockCountLine {
  id             String              @id @db.Char(36)
  organizationId String              @db.Char(36)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  countId        String              @db.Char(36)
  count          StockCount          @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)
  productId      String              @db.Char(36)
  product        Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  countedAt      DateTime            @db.DateTime(3)
  /// Balance of the location at `countedAt`, in the product's unit.
  systemQuantity Decimal             @db.Decimal(18, 3)
  unitCode       String              @db.VarChar(12)
  captures       StockCountCapture[]

  @@unique([organizationId, id])
  @@unique([organizationId, countId, productId])
  @@unique([organizationId, productId, id])
  @@map("stock_count_line")
}

/// What was written down for a product: «2 cajas», «30 piezas». Each
/// capture keeps how it was counted and what it is in the product's unit
/// (baseQuantity = capturedQuantity × factor); the count of the product is
/// the sum of its captures.
model StockCountCapture {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lineId                String               @db.Char(36)
  productId             String               @db.Char(36)
  line                  StockCountLine       @relation(fields: [organizationId, productId, lineId], references: [organizationId, productId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  capturedUnitCode      String?              @db.VarChar(12)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  createdByUserId       String               @db.Char(36)
  createdAt             DateTime             @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, lineId])
  @@map("stock_count_capture")
}

enum JobStatus {
  /// Waiting for its turn (or for its next attempt).
  PENDING
  /// A worker has it.
  RUNNING
  DONE
  /// It used up its attempts; nothing retries it again.
  FAILED
}

/// Work done in the background for a company (IMP-01): an import, an
/// export. The row is the queue — it survives restarts — and carries the
/// company it belongs to, which is the only company its handler works in.
model Job {
  id               String       @id @db.Char(36)
  organizationId   String       @db.Char(36)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Which handler runs it: "inventory.import_products".
  type             String       @db.VarChar(64)
  payload          Json
  status           JobStatus    @default(PENDING)
  /// Times a worker has started it.
  attempts         Int          @default(0)
  maxAttempts      Int          @default(5)
  /// Not before this moment (now, or later after a failed attempt).
  runAt            DateTime     @default(now()) @db.DateTime(3)
  lockedAt         DateTime?    @db.DateTime(3)
  lockedBy         String?      @db.VarChar(64)
  /// Why the last attempt failed, for people; never secrets.
  lastError        String?      @db.VarChar(500)
  result           Json?
  /// Person who asked for it (an account; not a company row).
  createdByUserId  String?      @db.Char(36)
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  finishedAt       DateTime?    @db.DateTime(3)
  /// When what a job that failed for good was holding was given back
  /// (IMP-08B); null while that is still to be done.
  failureHandledAt DateTime?    @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([status, runAt])
  @@index([status, failureHandledAt])
  @@index([organizationId, type, createdAt])
  @@map("job")
}

/// A private file of a company (IMP-02): what it uploaded to import, what
/// was generated for it to download. The row says whose it is; the bytes
/// live in the file storage under a key that starts with the company.
model StoredFile {
  id              String          @id @db.Char(36)
  organizationId  String          @db.Char(36)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// What it is for: "import_source", "export". Decides who may read it.
  purpose         String          @db.VarChar(40)
  /// Name shown to people; never used as a path.
  name            String          @db.VarChar(160)
  /// Decided by the server from the extension, not by the browser.
  contentType     String          @db.VarChar(100)
  size            Int
  sha256          String          @db.Char(64)
  /// Where the bytes are in the storage: "<organizationId>/<id>".
  storageKey      String          @db.VarChar(100)
  createdByUserId String          @db.Char(36)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  /// Set when it was removed; the bytes are gone, the row stays as a trace.
  deletedAt       DateTime?       @db.DateTime(3)
  productImports  ProductImport[]
  exitImports     ExitImport[]

  @@unique([organizationId, id])
  @@index([organizationId, purpose, createdAt])
  @@map("stored_file")
}

enum ProductImportStatus {
  /// The file was read; its columns are being matched to ours (IMP-04).
  MAPPING
  /// Columns and decimal separator are set; ready to be validated (IMP-05).
  READY
  /// The person confirmed it: its places of the plan are held (IMP-07)
  /// and nothing of it changes any more. The worker applies it (IMP-08).
  CONFIRMED
  /// The worker is applying it, in batches.
  RUNNING
  DONE
  /// It could not be finished; what was applied stays, the rest was not.
  FAILED
  CANCELLED
}

/// An import of products from a spreadsheet (IMP-04 on): the file that
/// was uploaded and how to read it. Nothing of the catalog changes until
/// the import is confirmed (IMP-08).
model ProductImport {
  id                  String              @id @db.Char(36)
  organizationId      String              @db.Char(36)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileId              String              @db.Char(36)
  file                StoredFile          @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict)
  status              ProductImportStatus @default(MAPPING)
  /// Sheet that was read; null for CSV.
  sheetName           String?             @db.VarChar(64)
  /// Row of the file (from 1) that holds the titles.
  headerRow           Int
  /// Titles of the file, by column: ["Clave", "Nombre", …].
  headers             Json
  /// Rows with data under the titles.
  dataRows            Int
  /// Cells that held a formula: their stored value is what is read.
  formulaCells        Int                 @default(0)
  /// Which column of the file feeds each of ours: { "sku": 0, "name": 1 }.
  mapping             Json
  /// "." or ","; null until the person says how decimals are written.
  decimalSeparator    String?             @db.Char(1)
  /// Places of the plan held for its new and reactivated products while
  /// it is applied; each one becomes a product or is given back.
  reservedPlaces      Int                 @default(0)
  confirmedAt         DateTime?           @db.DateTime(3)
  confirmedByUserId   String?             @db.Char(36)
  /// Permissions its operations need (create products, opening stock…),
  /// fixed when it was confirmed and checked again before each batch.
  requiredPermissions Json?
  /// Products of the file, fixed when it was confirmed (IMP-08).
  totalItems          Int                 @default(0)
  /// Of those, how many the worker has finished: applied or failed.
  processedItems      Int                 @default(0)
  failedItems         Int                 @default(0)
  finishedAt          DateTime?           @db.DateTime(3)
  /// Why it stopped, for people, when it could not be finished.
  lastError           String?             @db.VarChar(500)
  items               ProductImportItem[]
  createdByUserId     String              @db.Char(36)
  createdAt           DateTime            @default(now()) @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("product_import")
}

enum ProductImportItemStatus {
  PENDING
  /// The product was created, updated or reactivated.
  DONE
  /// This product could not be applied; the others go on.
  FAILED
}

/// One product of a confirmed import (IMP-08): what the file said about
/// it, fixed at the moment of confirming — its fields, the content of its
/// presentation, its stock by location. The worker applies items one by
/// one and marks them, so applying again never repeats one.
model ProductImportItem {
  id             String                  @id @db.Char(36)
  organizationId String                  @db.Char(36)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importId       String                  @db.Char(36)
  import         ProductImport           @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict)
  /// Order of the product in the file.
  position       Int
  sku            String                  @db.VarChar(64)
  /// What it was when confirmed: "new", "update" or "reactivate".
  kind           String                  @db.VarChar(12)
  data           Json
  status         ProductImportItemStatus @default(PENDING)
  /// The product it became, once applied.
  productId      String?                 @db.Char(36)
  error          String?                 @db.VarChar(300)
  appliedAt      DateTime?               @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, importId, position])
  @@index([organizationId, importId, status, position])
  @@map("product_import_item")
}

enum ExitImportStatus {
  /// The file was read and can be reviewed; nothing has left stock.
  READY
  /// The person confirmed it: its rows are fixed and wait for the worker.
  CONFIRMED
  /// The worker is registering its exits, in batches.
  RUNNING
  DONE
  /// It could not be finished; the exits registered stay, the rest did not.
  FAILED
  CANCELLED
}

/// A file of daily exits — what was sold or used, kept outside the system
/// — imported to take it out of stock (IMP-10). Each row names the sale it
/// comes from (`externalId`), so the same sale is never discounted twice,
/// whatever file brings it again.
model ExitImport {
  id                String           @id @db.Char(36)
  organizationId    String           @db.Char(36)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileId            String           @db.Char(36)
  file              StoredFile       @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict)
  status            ExitImportStatus @default(READY)
  /// "." or ",": how the person said decimals are written in the file.
  decimalSeparator  String           @db.Char(1)
  /// Rows with data under the titles.
  dataRows          Int
  /// Rows fixed when it was confirmed, and what became of them.
  totalRows         Int              @default(0)
  appliedRows       Int              @default(0)
  /// Sales that had already been imported: not discounted again.
  duplicateRows     Int              @default(0)
  failedRows        Int              @default(0)
  /// First and last day of the exits of the file (calendar of the company).
  firstDay          DateTime?        @db.Date
  lastDay           DateTime?        @db.Date
  confirmedAt       DateTime?        @db.DateTime(3)
  confirmedByUserId String?          @db.Char(36)
  finishedAt        DateTime?        @db.DateTime(3)
  /// Why it stopped, for people, when it could not be finished.
  lastError         String?          @db.VarChar(500)
  rows              ExitImportRow[]
  createdByUserId   String           @db.Char(36)
  createdAt         DateTime         @default(now()) @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("exit_import")
}

enum ExitImportRowStatus {
  PENDING
  /// Its exit was registered.
  DONE
  /// The same sale had already been imported: nothing left stock again.
  DUPLICATE
  /// It could not be registered (no stock, archived…); `error` says why.
  FAILED
}

/// One row of a confirmed file of exits: a product that left on a day, in
/// a sale the business identifies. Product, presentation and location are
/// fixed when confirming; the quantity is converted when the exit is
/// registered, like any movement.
model ExitImportRow {
  id             String              @id @db.Char(36)
  organizationId String              @db.Char(36)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importId       String              @db.Char(36)
  import         ExitImport          @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict)
  /// Row of the file.
  row            Int
  /// Identifier of the sale in the business: ticket, folio, note.
  externalId     String              @db.VarChar(64)
  /// Day it left, in the calendar of the company.
  day            DateTime            @db.Date
  productId      String              @db.Char(36)
  product        Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// Presentation it was counted in; null when in the product's unit.
  presentationId String?             @db.Char(36)
  /// As written in the file, with decimal point: "3", "2.75".
  quantity       String              @db.VarChar(24)
  locationId     String              @db.Char(36)
  location       Location            @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  status         ExitImportRowStatus @default(PENDING)
  error          String?             @db.VarChar(300)
  /// The exit it became, once registered.
  movementId     String?             @db.Char(36)
  appliedAt      DateTime?           @db.DateTime(3)
  /// Set only when its exit is registered: "<productId>:<externalId>".
  /// Unique in the company, so a sale of a product leaves stock once.
  appliedKey     String?             @db.VarChar(120)

  @@unique([organizationId, id])
  @@unique([organizationId, importId, row])
  @@unique([organizationId, appliedKey])
  @@index([organizationId, importId, status, row])
  @@index([organizationId, status, day])
  @@map("exit_import_row")
}

/// A person or business the company deals with (CMP-01): a supplier it
/// buys from, a customer it sells to, or both. Contacts belong to the
/// core, not to a module: Compras, Ventas and CRM share the same row
/// instead of each keeping its own copy of the same business. What a
/// contact is for a module is a facet (`isSupplier`, `isCustomer`), and a
/// contact always has at least one.
model Contact {
  id               String            @id @db.Char(36)
  organizationId   String            @db.Char(36)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// As the business knows it: «Ferretera del Norte».
  name             String            @db.VarChar(160)
  /// Legal name, when it differs: «Ferretera del Norte, S.A. de C.V.».
  legalName        String?           @db.VarChar(200)
  /// Mexican tax id, in capitals and without spaces; optional.
  rfc              String?           @db.VarChar(13)
  isSupplier       Boolean           @default(false)
  isCustomer       Boolean           @default(false)
  /// Who to ask for there.
  contactPerson    String?           @db.VarChar(120)
  email            String?           @db.VarChar(254)
  phone            String?           @db.VarChar(40)
  address          String?           @db.VarChar(300)
  notes            String?           @db.VarChar(500)
  /// Set when it is no longer used; its documents keep pointing to it.
  archivedAt       DateTime?         @db.DateTime(3)
  createdByUserId  String            @db.Char(36)
  createdAt        DateTime          @default(now()) @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @db.DateTime(3)
  suppliedProducts ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
  sales            Sale[]
  salesQuotes      SalesQuote[]
  salesOrders      SalesOrder[]

  @@unique([organizationId, id])
  /// Orders and searches the list of suppliers (name and RFC) in one index.
  @@index([organizationId, isSupplier, name, rfc, id])
  @@index([organizationId, isCustomer, name, id])
  @@index([organizationId, rfc])
  @@map("contact")
}

/// That a supplier sells a product to the company (CMP-03): the code the
/// supplier knows it by, the presentation it is bought in and what it
/// cost the last time. One row per product and supplier.
///
/// The presentation only says how it is bought; its content is the one of
/// the catalog and is never changed from here. The last cost is not typed
/// in: it is written when a purchase is registered, and shown only to who
/// may see costs.
model ProductSupplier {
  id                            String               @id @db.Char(36)
  organizationId                String               @db.Char(36)
  organization                  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId                     String               @db.Char(36)
  product                       Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// The contact, in its supplier facet (checked by the service).
  contactId                     String               @db.Char(36)
  contact                       Contact              @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  /// Code of the product in the supplier's catalog.
  supplierSku                   String?              @db.VarChar(64)
  /// Presentation of the product it is usually bought in; null = its unit.
  presentationId                String?              @db.Char(36)
  presentation                  ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  /// What one unit of purchase cost the last time, in pesos, before taxes.
  lastCost                      Decimal?             @db.Decimal(14, 4)
  /// What that cost was for: the version of the presentation bought, or
  /// null when it was bought by the product's unit.
  lastCostPresentationId        String?              @db.Char(36)
  lastCostPresentationVersionId String?              @db.Char(36)
  lastCostVersion               PresentationVersion? @relation(fields: [organizationId, lastCostPresentationId, lastCostPresentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  lastCostAt                    DateTime?            @db.DateTime(3)
  createdByUserId               String               @db.Char(36)
  createdAt                     DateTime             @default(now()) @db.DateTime(3)
  updatedAt                     DateTime             @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, contactId])
  @@index([organizationId, contactId, productId])
  @@map("product_supplier")
}

enum PurchaseOrderStatus {
  /// Being written: its lines can still change (CMP-04).
  DRAFT
  /// Sent to the supplier; nothing received yet (CMP-05).
  SENT
  /// Part of it was received.
  PARTIAL
  RECEIVED
  CANCELLED
  /// Received in part and closed with what was missing (CMP-11): the rest
  /// is no longer expected.
  CLOSED
}

/// What the company asks a supplier for (CMP-04). It is numbered within
/// the company and starts as a draft, the only state in which its lines
/// can be added, changed or removed.
model PurchaseOrder {
  id                String                  @id @db.Char(36)
  organizationId    String                  @db.Char(36)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive within the company: shown as «OC-0001».
  number            Int
  /// The contact, in its supplier facet (checked by the service).
  contactId         String                  @db.Char(36)
  contact           Contact                 @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  status            PurchaseOrderStatus     @default(DRAFT)
  /// Day it is expected to arrive, in the calendar of the company.
  expectedOn        DateTime?               @db.Date
  notes             String?                 @db.VarChar(500)
  /// When a person confirmed it as sent, and who (CMP-05).
  sentAt            DateTime?               @db.DateTime(3)
  sentByUserId      String?                 @db.Char(36)
  /// When and why it was cancelled, and by whom.
  cancelledAt       DateTime?               @db.DateTime(3)
  cancelledByUserId String?                 @db.Char(36)
  cancelReason      String?                 @db.VarChar(300)
  /// When, why and by whom it was closed with a shortage (CMP-11). The
  /// shortage itself is ordered − received, both fixed by then.
  closedAt          DateTime?               @db.DateTime(3)
  closedByUserId    String?                 @db.Char(36)
  closeReason       String?                 @db.VarChar(300)
  lines             PurchaseOrderLine[]
  deliveries        PurchaseOrderDelivery[]
  receipts          PurchaseReceipt[]
  createdByUserId   String                  @db.Char(36)
  createdAt         DateTime                @default(now()) @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, number])
  @@index([organizationId, contactId, number])
  @@map("purchase_order")
}

enum PurchaseOrderDeliveryStatus {
  /// Waiting for the worker, or between attempts.
  QUEUED
  SENT
  /// It will not be tried again; a person may ask for another one.
  FAILED
}

/// One time a person asked to send an order to its supplier by mail
/// (CMP-06B). The worker sends it; the row says how it ended. The address
/// is the one the supplier had when it was asked, and the row no longer
/// changes once it is sent or failed (trigger). Sending does not move the
/// state of the order.
model PurchaseOrderDelivery {
  id                String                      @id @db.Char(36)
  organizationId    String                      @db.Char(36)
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId           String                      @db.Char(36)
  order             PurchaseOrder               @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  recipient         String                      @db.VarChar(254)
  status            PurchaseOrderDeliveryStatus @default(QUEUED)
  /// The job that sends it (a row of `job` of the same company).
  jobId             String                      @db.Char(36)
  requestedByUserId String                      @db.Char(36)
  requestedAt       DateTime                    @default(now()) @db.DateTime(3)
  sentAt            DateTime?                   @db.DateTime(3)
  failedAt          DateTime?                   @db.DateTime(3)
  /// Why it was not sent, for people; never the answer of a mail server.
  failureReason     String?                     @db.VarChar(300)

  @@unique([organizationId, id])
  @@unique([organizationId, jobId])
  @@index([organizationId, orderId, requestedAt])
  @@index([organizationId, requestedAt])
  @@map("purchase_order_delivery")
}

/// One product of a purchase order. Like a movement line, it keeps what
/// was asked for as it was written, the presentation and the version of
/// its content at that moment, and the result in the product's unit:
///
///   baseQuantity = capturedQuantity × factor   (CHECK, exact decimals)
///
/// so «3 cajas × 100 = 300 piezas» stays what was ordered even if the box
/// changes later. The cost is of one unit of what was captured (one box).
model PurchaseOrderLine {
  id                    String                @id @db.Char(36)
  organizationId        String                @db.Char(36)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId               String                @db.Char(36)
  order                 PurchaseOrder         @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String                @db.Char(36)
  product               Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// Code of the product at the supplier when the line was written.
  supplierSku           String?               @db.VarChar(64)
  capturedQuantity      Decimal               @db.Decimal(12, 3)
  /// Presentation ordered, with the version whose content was applied.
  presentationId        String?               @db.Char(36)
  presentation          ProductPresentation?  @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?               @db.Char(36)
  presentationVersion   PresentationVersion?  @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Multiplier applied; 1 when ordered in the product's unit.
  factor                Decimal               @db.Decimal(18, 6)
  /// Quantity in the product's unit: what will enter stock when received.
  baseQuantity          Decimal               @db.Decimal(12, 3)
  unitCode              String                @db.VarChar(12)
  /// Cost of one captured unit (one box), in pesos, before taxes; null
  /// while it is not known. Private to who may see costs.
  unitCost              Decimal?              @db.Decimal(14, 4)
  receiptLines          PurchaseReceiptLine[]
  createdAt             DateTime              @default(now()) @db.DateTime(3)
  updatedAt             DateTime              @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNumber])
  @@index([organizationId, productId, orderId])
  @@map("purchase_order_line")
}

/// One time goods of a purchase order arrived (CMP-07). It is written in
/// the same transaction as its stock movement (`RECEIPT`) and the
/// balances: all of it exists or none. Never changed nor deleted
/// (triggers): a mistake is corrected from Compras (a return, CMP-12).
model PurchaseReceipt {
  id               String                @id @db.Char(36)
  organizationId   String                @db.Char(36)
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId          String                @db.Char(36)
  order            PurchaseOrder         @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  /// The entry of stock it made; one movement per receipt.
  movementId       String                @db.Char(36)
  movement         StockMovement         @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  /// Delivery note or invoice of the supplier it came with.
  reference        String?               @db.VarChar(120)
  /// Sent with the confirmation so that repeating it receives once.
  idempotencyKey   String                @db.VarChar(64)
  receivedByUserId String                @db.Char(36)
  createdAt        DateTime              @default(now()) @db.DateTime(3)
  lines            PurchaseReceiptLine[]
  returns          PurchaseReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, orderId, createdAt])
  @@map("purchase_receipt")
}

/// What arrived of one line of the order, where it was put and how it was
/// converted. The quantity is in the terms of the order line (3 boxes);
/// the factor is the one in force when it was received, so the stock that
/// entered is `baseQuantity` (CHECK: captured × factor, exact decimals).
model PurchaseReceiptLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptId             String               @db.Char(36)
  receipt               PurchaseReceipt      @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  /// The line of the order it receives (same order and product: trigger).
  orderLineId           String               @db.Char(36)
  orderLine             PurchaseOrderLine    @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  locationId            String               @db.Char(36)
  location              Location             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  /// What one captured unit (one box) cost, copied from the order line
  /// when it arrived (CMP-13); null when the order had no cost. Private to
  /// who may see costs.
  unitCost              Decimal?             @db.Decimal(14, 4)
  createdAt             DateTime             @default(now()) @db.DateTime(3)
  returnLines           PurchaseReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, receiptId, lineNumber])
  @@index([organizationId, orderLineId])
  @@index([organizationId, productId, createdAt])
  @@map("purchase_receipt_line")
}

/// Goods of a receipt sent back to the supplier (CMP-12). Written in the
/// same transaction as its stock movement (`RETURN`, an exit) and the
/// balances. Never changed nor deleted (triggers). What is returned of a
/// receipt line never adds up to more than what it received.
model PurchaseReturn {
  id               String               @id @db.Char(36)
  organizationId   String               @db.Char(36)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptId        String               @db.Char(36)
  receipt          PurchaseReceipt      @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  /// The exit of stock it made; one movement per return.
  movementId       String               @db.Char(36)
  movement         StockMovement        @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  /// Why it goes back: damaged, wrong product, more than ordered…
  reason           String               @db.VarChar(300)
  /// Sent with the confirmation so that repeating it returns once.
  idempotencyKey   String               @db.VarChar(64)
  returnedByUserId String               @db.Char(36)
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  lines            PurchaseReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receiptId, createdAt])
  @@map("purchase_return")
}

/// What goes back of one receipt line, in its terms (boxes) and with the
/// factor it was received with: what leaves is what entered for it.
model PurchaseReturnLine {
  id               String              @id @db.Char(36)
  organizationId   String              @db.Char(36)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  returnId         String              @db.Char(36)
  return           PurchaseReturn      @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict)
  lineNumber       Int
  /// The receipt line it returns (same receipt and product: trigger).
  receiptLineId    String              @db.Char(36)
  receiptLine      PurchaseReceiptLine @relation(fields: [organizationId, receiptLineId], references: [organizationId, id], onDelete: Restrict)
  productId        String              @db.Char(36)
  product          Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// Where it is taken from.
  locationId       String              @db.Char(36)
  location         Location            @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity Decimal             @db.Decimal(12, 3)
  factor           Decimal             @db.Decimal(18, 6)
  baseQuantity     Decimal             @db.Decimal(12, 3)
  unitCode         String              @db.VarChar(12)
  createdAt        DateTime            @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, returnId, lineNumber])
  @@index([organizationId, receiptLineId])
  @@index([organizationId, productId, createdAt])
  @@map("purchase_return_line")
}

// ── Ventas (VEN, ADR 0030) ──────────────────────────────────────────────

/// Sale price of a product (VEN-03): of its unit (no presentation) or of
/// one of its presentations, each with its own price (a box of 500 at
/// $500, a loose screw at $1.50). A presentation without one sells at
/// content × unit price. With or without VAT as the company decides
/// (VEN-04). Written only by `setSalePrices`, under the product's lock.
model SalePrice {
  id              String               @id @db.Char(36)
  organizationId  String               @db.Char(36)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String               @db.Char(36)
  product         Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  presentationId  String?              @db.Char(36)
  presentation    ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict)
  price           Decimal              @db.Decimal(12, 2)
  updatedByUserId String               @db.Char(36)
  updatedAt       DateTime             @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, presentationId])
  @@map("sale_price")
}

/// How a company sells (VEN-04, ADR 0030): one row, only once the titular
/// changes something; without it, VAT 16 % included.
model SalesSettings {
  id                       String       @id @db.Char(36)
  organizationId           String       @unique @db.Char(36)
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pricesIncludeTax         Boolean      @default(true)
  /// Percent, 0 to 100.
  taxRate                  Decimal      @default(16) @db.Decimal(5, 2)
  /// Largest discount, in percent, each role gives without asking (VEN-14).
  /// The titular has no cap.
  discountCapCashier       Decimal      @default(5) @db.Decimal(5, 2)
  discountCapCashManager   Decimal      @default(20) @db.Decimal(5, 2)
  discountCapAdministrator Decimal      @default(100) @db.Decimal(5, 2)
  updatedByUserId          String       @db.Char(36)
  updatedAt                DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@map("sales_settings")
}

enum SaleStatus {
  COMPLETED
  /// Undone with permission and a reason (VEN-21); its goods went back.
  CANCELLED
}

enum SalePaymentMethod {
  CASH
  /// External terminal: the app only keeps its reference (VEN-12).
  CARD
  TRANSFER
}

/// A counter sale (VEN-05, ADR 0030): what was sold, at what price and how
/// it was paid. Written once, in the same transaction as its stock exit
/// (`SALE` movement) and the balances; its amounts never change (trigger).
/// The VAT rule in force is copied, so the ticket can always be rebuilt:
///
///   subtotal + tax = total   (CHECK, exact decimals)
model Sale {
  id                      String                     @id @db.Char(36)
  organizationId          String                     @db.Char(36)
  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive number of the company, for the ticket: 1, 2, 3…
  number                  Int
  status                  SaleStatus                 @default(COMPLETED)
  /// Customer when known; null = público en general.
  customerId              String?                    @db.Char(36)
  customer                Contact?                   @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  /// The exit of stock it made; one movement per sale.
  movementId              String                     @db.Char(36)
  movement                StockMovement              @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  /// VAT rule when it was sold (VEN-04).
  pricesIncludeTax        Boolean
  taxRate                 Decimal                    @db.Decimal(5, 2)
  /// Sum of what the discounts took off the lines.
  discount                Decimal                    @default(0) @db.Decimal(14, 2)
  /// Discount of the whole sale, in percent, and why (VEN-14).
  discountPercent         Decimal                    @default(0) @db.Decimal(5, 2)
  discountReason          String?                    @db.VarChar(200)
  /// Who allowed a discount above the seller's cap, used once.
  discountAuthorizationId String?                    @db.Char(36)
  discountAuthorization   SaleDiscountAuthorization? @relation(fields: [organizationId, discountAuthorizationId], references: [organizationId, id], onDelete: Restrict)
  /// The cash register of who charged it (VEN-16); null for sales from
  /// before registers existed.
  cashSessionId           String?                    @db.Char(36)
  cashSession             CashSession?               @relation(fields: [organizationId, cashSessionId], references: [organizationId, id], onDelete: Restrict)
  subtotal                Decimal                    @db.Decimal(14, 2)
  tax                     Decimal                    @db.Decimal(14, 2)
  total                   Decimal                    @db.Decimal(14, 2)
  /// Sent with the confirmation so that repeating it sells once (VEN-10).
  idempotencyKey          String                     @db.VarChar(64)
  soldByUserId            String                     @db.Char(36)
  createdAt               DateTime                   @default(now()) @db.DateTime(3)
  cancelledByUserId       String?                    @db.Char(36)
  cancelledAt             DateTime?                  @db.DateTime(3)
  cancelReason            String?                    @db.VarChar(500)
  /// The order it fulfills (COT-07); null for a counter sale.
  salesOrderId            String?                    @db.Char(36)
  salesOrder              SalesOrder?                @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: Restrict)
  lines                   SaleLine[]
  payments                SalePayment[]
  returns                 SaleReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, discountAuthorizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, cashSessionId])
  @@index([organizationId, soldByUserId, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, salesOrderId])
  @@map("sale")
}

/// One product of a sale, as it was sold: the presentation and quantity
/// the customer took (1 caja, 2.75 m), its price and discount, and what
/// left the stock (`baseQuantity` = captured × factor, CHECK).
///
///   amount = capturedQuantity × unitPrice − discount, in cents (CHECK ≥ 0)
model SaleLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  saleId                String               @db.Char(36)
  sale                  Sale                 @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// Where it left from.
  locationId            String               @db.Char(36)
  location              Location             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  /// Price of one captured unit (one box, one meter) before the discount,
  /// as the company writes its prices (with or without VAT).
  unitPrice             Decimal              @db.Decimal(12, 2)
  /// What was taken off this line (VEN-14).
  discount              Decimal              @default(0) @db.Decimal(12, 2)
  amount                Decimal              @db.Decimal(14, 2)
  /// Average cost of one unit of the product it took (VAL, ADR 0031);
  /// null when unknown. Private to who may see costs.
  unitCost              Decimal?             @db.Decimal(18, 6)
  /// The line of the order it fulfills (COT-07), in the same terms.
  orderLineId           String?              @db.Char(36)
  orderLine             SalesOrderLine?      @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)
  returnLines           SaleReturnLine[]
  createdAt             DateTime             @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, saleId, lineNumber])
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, orderLineId])
  @@map("sale_line")
}

/// How a sale was paid; several when it was mixed (VEN-13). `amount` is
/// what goes to the sale; for cash, what was handed over and the change.
model SalePayment {
  id             String            @id @db.Char(36)
  organizationId String            @db.Char(36)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  saleId         String            @db.Char(36)
  sale           Sale              @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  lineNumber     Int
  method         SalePaymentMethod
  amount         Decimal           @db.Decimal(14, 2)
  /// Cash only: what the customer handed over and the change returned.
  received       Decimal?          @db.Decimal(14, 2)
  changeGiven    Decimal?          @db.Decimal(14, 2)
  /// Card or transfer: authorization or tracking number.
  reference      String?           @db.VarChar(60)
  createdAt      DateTime          @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, saleId, lineNumber])
  @@index([organizationId, method, createdAt])
  @@map("sale_payment")
}

/// A discount above the seller's cap, allowed at the counter by someone
/// with a cap large enough who typed their password there (VEN-14). It is
/// for one seller, up to its percent, for a few minutes, and for one sale.
model SaleDiscountAuthorization {
  id               String       @id @db.Char(36)
  organizationId   String       @db.Char(36)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sellerUserId     String       @db.Char(36)
  authorizerUserId String       @db.Char(36)
  /// Largest percent it allows.
  percent          Decimal      @db.Decimal(5, 2)
  /// The authorizer may also sell below cost.
  belowCost        Boolean
  reason           String       @db.VarChar(200)
  expiresAt        DateTime     @db.DateTime(3)
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  sale             Sale?

  @@unique([organizationId, id])
  @@index([organizationId, sellerUserId, createdAt])
  @@map("sale_discount_authorization")
}

/// A cash register shift (VEN-16): someone opens it with a float, charges
/// into it, puts money in or takes it out (VEN-17), and a cash manager
/// closes it counting what there is against what there should be (VEN-18).
/// One open register per person; without one, nobody charges.
model CashSession {
  id               String         @id @db.Char(36)
  organizationId   String         @db.Char(36)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  openedByUserId   String         @db.Char(36)
  /// Cash it starts with, to give change.
  openingFloat     Decimal        @db.Decimal(14, 2)
  openedAt         DateTime       @default(now()) @db.DateTime(3)
  /// True while open, NULL once closed (never false): one open per person.
  isOpen           Boolean?       @default(true)
  closedAt         DateTime?      @db.DateTime(3)
  closedByUserId   String?        @db.Char(36)
  /// What should have been there at the close, by payment method.
  expectedCash     Decimal?       @db.Decimal(14, 2)
  expectedCard     Decimal?       @db.Decimal(14, 2)
  expectedTransfer Decimal?       @db.Decimal(14, 2)
  /// What was counted at the close.
  countedCash      Decimal?       @db.Decimal(14, 2)
  countedCard      Decimal?       @db.Decimal(14, 2)
  countedTransfer  Decimal?       @db.Decimal(14, 2)
  closeNote        String?        @db.VarChar(500)
  sales            Sale[]
  movements        CashMovement[]
  saleReturns      SaleReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, openedByUserId, isOpen])
  @@index([organizationId, openedAt])
  @@map("cash_session")
}

enum CashMovementDirection {
  IN
  OUT
}

/// Money put into or taken out of a register, with its reason (VEN-17):
/// change brought from the bank, a payment to a supplier from the drawer.
model CashMovement {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessionId       String                @db.Char(36)
  session         CashSession           @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)
  direction       CashMovementDirection
  amount          Decimal               @db.Decimal(14, 2)
  reason          String                @db.VarChar(200)
  createdByUserId String                @db.Char(36)
  createdAt       DateTime              @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, sessionId, createdAt])
  @@map("cash_movement")
}

/// Goods of a sale that came back and the money given back (VEN-19..21).
/// Written in one transaction with its stock entry (`SALE_RETURN`); never
/// changed nor deleted. A cash refund comes out of the open register of
/// who gives it. `cancelsSale` marks the one that cancelled the sale.
model SaleReturn {
  id              String            @id @db.Char(36)
  organizationId  String            @db.Char(36)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  saleId          String            @db.Char(36)
  sale            Sale              @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict)
  movementId      String            @db.Char(36)
  movement        StockMovement     @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  refundMethod    SalePaymentMethod
  /// What was given back, VAT included.
  refund          Decimal           @db.Decimal(14, 2)
  /// Card or transfer: the reference of the refund.
  reference       String?           @db.VarChar(60)
  cashSessionId   String?           @db.Char(36)
  cashSession     CashSession?      @relation(fields: [organizationId, cashSessionId], references: [organizationId, id], onDelete: Restrict)
  reason          String            @db.VarChar(500)
  cancelsSale     Boolean           @default(false)
  idempotencyKey  String            @db.VarChar(64)
  createdByUserId String            @db.Char(36)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  lines           SaleReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, saleId])
  @@index([organizationId, cashSessionId])
  @@map("sale_return")
}

/// What came back of one line of the sale, in the terms it was sold (1
/// box), with the factor and cost of that line.
model SaleReturnLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  returnId              String               @db.Char(36)
  saleReturn            SaleReturn           @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  saleLineId            String               @db.Char(36)
  saleLine              SaleLine             @relation(fields: [organizationId, saleLineId], references: [organizationId, id], onDelete: Restrict)
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  locationId            String               @db.Char(36)
  location              Location             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  unitCost              Decimal?             @db.Decimal(18, 6)
  /// Part of the refund for this line, before VAT is added on top.
  refund                Decimal              @db.Decimal(14, 2)
  createdAt             DateTime             @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, returnId, lineNumber])
  @@index([organizationId, saleLineId])
  @@map("sale_return_line")
}

/// Where a quote stands (COT-01, ADR 0030). «Vencida» is not stored: a
/// sent quote whose day of validity passed is expired when read.
enum SalesQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

/// A quote to a customer (COT-01, ADR 0030): prices of the moment it was
/// written, valid up to a day of the company's calendar. It never touches
/// stock nor the cash register. Its totals are not stored: they come from
/// its lines with `saleTotals`, like a sale's.
model SalesQuote {
  id               String               @id @db.Char(36)
  organizationId   String               @db.Char(36)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive number of the company: 1, 2, 3…
  number           Int
  status           SalesQuoteStatus     @default(DRAFT)
  /// Always a customer: a quote goes to someone.
  customerId       String               @db.Char(36)
  customer         Contact              @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  /// Last day it holds, of the company's calendar.
  validUntil       DateTime             @db.Date
  /// VAT rule when it was written (VEN-04).
  pricesIncludeTax Boolean
  taxRate          Decimal              @db.Decimal(5, 2)
  /// Discount of the whole quote, in percent, and why (VEN-14).
  discountPercent  Decimal              @default(0) @db.Decimal(5, 2)
  discountReason   String?              @db.VarChar(200)
  /// For the customer: conditions, delivery, what was talked about.
  notes            String?              @db.VarChar(1000)
  createdByUserId  String               @db.Char(36)
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  updatedAt        DateTime             @updatedAt @db.DateTime(3)
  sentAt           DateTime?            @db.DateTime(3)
  /// Accepted or rejected: when, by whom (who recorded it) and why.
  decidedAt        DateTime?            @db.DateTime(3)
  decidedByUserId  String?              @db.Char(36)
  rejectReason     String?              @db.VarChar(500)
  lines            SalesQuoteLine[]
  deliveries       SalesQuoteDelivery[]
  order            SalesOrder?

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, validUntil])
  @@index([organizationId, customerId, createdAt])
  @@map("sales_quote")
}

/// A line of a quote: like a line of a sale, without location nor cost
/// (nothing leaves stock until it is sold).
model SalesQuoteLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quoteId               String               @db.Char(36)
  quote                 SalesQuote           @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  /// Price of one captured unit before the discount, as the company
  /// writes its prices (with or without VAT).
  unitPrice             Decimal              @db.Decimal(12, 2)
  discount              Decimal              @default(0) @db.Decimal(12, 2)
  amount                Decimal              @db.Decimal(14, 2)
  createdAt             DateTime             @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, quoteId, lineNumber])
  @@index([organizationId, productId])
  @@map("sales_quote_line")
}

/// How a mail of a quote ended (COT-03).
enum SalesQuoteDeliveryStatus {
  /// Waiting for the worker, or between attempts.
  QUEUED
  SENT
  /// It will not be tried again; a person may ask for another one.
  FAILED
}

/// A quote sent to its customer by mail (COT-03, like ADR 0020): asked
/// for by a person, sent by the worker with the PDF attached.
model SalesQuoteDelivery {
  id                String                   @id @db.Char(36)
  organizationId    String                   @db.Char(36)
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quoteId           String                   @db.Char(36)
  quote             SalesQuote               @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  /// The customer's address when it was asked for; never typed on the spot.
  recipient         String                   @db.VarChar(254)
  status            SalesQuoteDeliveryStatus @default(QUEUED)
  /// The job that sends it (a row of `job` of the same company).
  jobId             String                   @db.Char(36)
  requestedByUserId String                   @db.Char(36)
  requestedAt       DateTime                 @default(now()) @db.DateTime(3)
  sentAt            DateTime?                @db.DateTime(3)
  failedAt          DateTime?                @db.DateTime(3)
  /// Why it was not sent, for people; never the answer of a mail server.
  failureReason     String?                  @db.VarChar(300)

  @@unique([organizationId, id])
  @@unique([organizationId, jobId])
  @@index([organizationId, quoteId, requestedAt])
  @@index([organizationId, requestedAt])
  @@map("sales_quote_delivery")
}

/// Where a sales order stands (COT-05): open until it is fulfilled or
/// cancelled (COT-07, COT-09).
enum SalesOrderStatus {
  OPEN
  PARTIAL
  FULFILLED
  CANCELLED
}

/// An order of a customer (COT-05, ADR 0030): what an accepted quote
/// becomes, with its prices, discount and VAT rule copied as they were
/// accepted. It does not touch stock until it is fulfilled (COT-07).
model SalesOrder {
  id               String           @id @db.Char(36)
  organizationId   String           @db.Char(36)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive number of the company: 1, 2, 3…
  number           Int
  status           SalesOrderStatus @default(OPEN)
  /// The accepted quote it comes from; one order per quote.
  quoteId          String           @db.Char(36)
  quote            SalesQuote       @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  customerId       String           @db.Char(36)
  customer         Contact          @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  pricesIncludeTax Boolean
  taxRate          Decimal          @db.Decimal(5, 2)
  discountPercent  Decimal          @default(0) @db.Decimal(5, 2)
  discountReason   String?          @db.VarChar(200)
  notes            String?          @db.VarChar(1000)
  createdByUserId  String           @db.Char(36)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  lines            SalesOrderLine[]
  /// What was fulfilled of it: each delivery is a sale (COT-07).
  sales            Sale[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, quoteId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@map("sales_order")
}

/// A line of an order, copied from its quote's line.
model SalesOrderLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId               String               @db.Char(36)
  order                 SalesOrder           @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  unitPrice             Decimal              @db.Decimal(12, 2)
  discount              Decimal              @default(0) @db.Decimal(12, 2)
  amount                Decimal              @db.Decimal(14, 2)
  createdAt             DateTime             @default(now()) @db.DateTime(3)
  saleLines             SaleLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNumber])
  @@index([organizationId, productId])
  @@map("sales_order_line")
}
