// Database schema. Models are added step by step (PLT-01 onwards).
// Every business table carries organization_id (see AGENTS.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ── Identity (Better Auth core tables, BAS-04) ───────────────────────────
// IDs are UUIDv7 generated by the app (src/lib/ids.ts).

model User {
  id               String         @id @db.Char(36)
  name             String         @db.VarChar(120)
  email            String         @unique @db.VarChar(254)
  emailVerified    Boolean        @default(false)
  /// Set by Better Auth once a TOTP app is verified (PLT-08A).
  twoFactorEnabled Boolean        @default(false)
  image            String?        @db.Text
  createdAt        DateTime       @default(now()) @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @db.DateTime(3)
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
  memberships      Membership[]
  ownedOrgs        Organization[] @relation("OrganizationOwner")
  platformStaff    PlatformStaff?

  @@map("user")
}

model Session {
  id                   String        @id @db.Char(36)
  expiresAt            DateTime      @db.DateTime(3)
  token                String        @unique @db.VarChar(255)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)
  ipAddress            String?       @db.VarChar(64)
  userAgent            String?       @db.Text
  userId               String        @db.Char(36)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Company this session works in (PLT-11). Re-checked against an active
  /// membership on every request; never trusted on its own.
  activeOrganizationId String?       @db.Char(36)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id @db.Char(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.Char(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.Char(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("verification")
}

/// TOTP secret and backup codes (Better Auth two-factor plugin, PLT-08A).
/// Both are encrypted with BETTER_AUTH_SECRET; `verified` stays false until
/// the first code from the app is confirmed.
model TwoFactor {
  id                      String    @id @db.Char(36)
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String    @unique @db.Char(36)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.DateTime(3)

  @@map("twoFactor")
}

// ── Tenancy (PLT-01) ──────────────────────────────────────────────────────
// Every business table will reference organization_id. Deletes never
// cascade across tenants: removing data is an explicit, audited process.

model Organization {
  id                   String                @id @db.Char(36)
  name                 String                @db.VarChar(120)
  timeZone             String                @default("America/Mexico_City") @db.VarChar(64)
  currency             String                @default("MXN") @db.Char(3)
  /// Titular: the only account allowed to contract or cancel (USR-03).
  ownerUserId          String                @db.Char(36)
  owner                User                  @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdAt            DateTime              @default(now()) @db.DateTime(3)
  updatedAt            DateTime              @updatedAt @db.DateTime(3)
  memberships          Membership[]
  memberRoles          MembershipRole[]
  sessions             Session[]
  auditEvents          AuditEvent[]
  ownershipTransfers   OwnershipTransfer[]
  invitations          Invitation[]
  subscriptions        Subscription[]
  subscriptionItems    SubscriptionItem[]
  entitlements         Entitlement[]
  quotaUsages          QuotaUsage[]
  products             Product[]
  productCategories    ProductCategory[]
  productBrands        ProductBrand[]
  productPresentations ProductPresentation[]
  presentationVersions PresentationVersion[]
  facilities           Facility[]
  locations            Location[]

  @@index([ownerUserId])
  @@map("organization")
}

// Shared physical space (INV-13). V1 has one facility per company;
// multi-facility operation requires an explicit future migration.
model Facility {
  id             String       @id @db.Char(36)
  organizationId String       @unique @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(120)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  locations      Location[]

  @@unique([organizationId, id])
  @@map("facility")
}

model Location {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityId     String       @db.Char(36)
  facility       Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict)
  name           String       @db.VarChar(120)
  /// True for General, NULL for other locations (never false; SQL CHECK).
  /// MySQL allows multiple NULLs in the unique key, but only one true.
  isDefault      Boolean?
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, facilityId, name])
  @@unique([organizationId, facilityId, isDefault])
  @@map("location")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id              String              @id @db.Char(36)
  organizationId  String              @db.Char(36)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId          String              @db.Char(36)
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          MembershipStatus    @default(ACTIVE)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)
  roles           MembershipRole[]
  ownershipOffers OwnershipTransfer[]

  @@unique([organizationId, userId])
  /// Target of company-scoped foreign keys (PLT-13).
  @@unique([organizationId, id])
  @@index([userId])
  @@map("membership")
}

/// Roles of a member (USR-01/USR-06). Values come from the role catalog in
/// code once the matrix is approved (FUN-07). The composite foreign key
/// includes organizationId, so a role can never point to a membership of
/// another company (PLT-13).
model MembershipRole {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipId   String       @db.Char(36)
  membership     Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role           String       @db.VarChar(40)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([membershipId, role])
  @@index([organizationId, membershipId])
  @@map("membership_role")
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// Offer to hand the company over to another member (USR-03B). The titular
/// offers, the recipient accepts; only then Organization.ownerUserId
/// changes, in one transaction. At most one PENDING offer per company
/// (checked under a lock on the organization row).
model OwnershipTransfer {
  id                 String                  @id @db.Char(36)
  organizationId     String                  @db.Char(36)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Titular who made the offer.
  fromUserId         String                  @db.Char(36)
  /// Membership of the person who would become titular.
  toMembershipId     String                  @db.Char(36)
  toMembership       Membership              @relation(fields: [organizationId, toMembershipId], references: [organizationId, id], onDelete: Cascade)
  /// Roles the previous titular keeps afterwards (chosen by them).
  previousOwnerRoles Json
  status             OwnershipTransferStatus @default(PENDING)
  expiresAt          DateTime                @db.DateTime(3)
  createdAt          DateTime                @default(now()) @db.DateTime(3)
  resolvedAt         DateTime?               @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, toMembershipId])
  @@map("ownership_transfer")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// Invitation to join a company with roles already chosen (USR-04). The
/// link carries a random token; only its SHA-256 is stored. It works once
/// and expires. The titular is never invited: roles come from the catalog.
model Invitation {
  id              String           @id @db.Char(36)
  organizationId  String           @db.Char(36)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Normalized (trimmed, lower case) address the link was sent to.
  email           String           @db.VarChar(254)
  tokenHash       String           @unique @db.Char(64)
  roles           Json
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @db.Char(36)
  expiresAt       DateTime         @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  resolvedAt      DateTime?        @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("invitation")
}

// ── Brute-force protection (PLT-06) ──────────────────────────────────────

/// Attempt counters for sign-in, registration and verification emails.
/// Keys never contain raw emails (SHA-256 of the normalized address).
model AuthThrottle {
  key          String    @id @db.VarChar(191)
  count        Int
  windowStart  DateTime  @db.DateTime(3)
  blockedUntil DateTime? @db.DateTime(3)

  @@index([windowStart])
  @@map("auth_throttle")
}

/// Better Auth's own limiter for the /api/auth HTTP endpoints.
model RateLimit {
  id          String @id @db.Char(36)
  key         String @unique @db.VarChar(191)
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ── Audit log (PLT-14) ───────────────────────────────────────────────────
// Append-only: database triggers reject UPDATE and DELETE for every user.
// Metadata is sanitized before it is stored (no passwords, tokens or codes).

/// Sensitive changes inside a company: who, what, on which record and why.
model AuditEvent {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Null for changes made by the system. No foreign key: the history
  /// outlives accounts.
  actorUserId    String?      @db.Char(36)
  action         String       @db.VarChar(80)
  targetType     String?      @db.VarChar(40)
  targetId       String?      @db.VarChar(64)
  reason         String?      @db.VarChar(500)
  metadata       Json?
  ipAddress      String?      @db.VarChar(64)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, targetType, targetId])
  @@map("audit_event")
}

/// Account security events (password, MFA, sessions), not tied to a company.
model SecurityEvent {
  id        String   @id @db.Char(36)
  /// No foreign key: the history outlives accounts.
  userId    String   @db.Char(36)
  action    String   @db.VarChar(80)
  metadata  Json?
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([userId, createdAt])
  @@map("security_event")
}

// ── Commercial model (MOD-03) ────────────────────────────────────────────

/// One published set of conditions for a capacity tier: product quota,
/// included users and prices. Never edited once a company contracted it:
/// a change of price or limit is a new version, so existing subscriptions
/// keep the conditions they accepted.
model PlanVersion {
  id             String            @id @db.Char(36)
  /// Capacity tier, e.g. "t1000" (1,000 active products).
  tier           String            @db.VarChar(20)
  version        Int
  name           String            @db.VarChar(80)
  productLimit   Int
  includedUsers  Int
  currency       String            @default("MXN") @db.Char(3)
  /// Monthly price of each additional user, before taxes.
  extraUserPrice Decimal           @db.Decimal(12, 2)
  effectiveFrom  DateTime          @db.DateTime(3)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  modulePrices   PlanModulePrice[]
  subscriptions  Subscription[]
  offers         PlanOffer[]

  @@unique([tier, version])
  @@map("plan_version")
}

/// Which version of a tier is offered to new customers today. Publishing
/// a new price moves this pointer; the versions themselves never change.
model PlanOffer {
  tier          String      @id @db.VarChar(20)
  planVersionId String      @db.Char(36)
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)

  @@map("plan_offer")
}

/// Monthly price of a module in a plan version, before taxes.
model PlanModulePrice {
  id            String      @id @db.Char(36)
  planVersionId String      @db.Char(36)
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  /// Module id from the registry (src/modules/registry).
  moduleId      String      @db.VarChar(40)
  monthlyPrice  Decimal     @db.Decimal(12, 2)

  @@unique([planVersionId, moduleId])
  @@map("plan_module_price")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
}

/// What a company contracted: one plan version, its period and extra
/// users. One per company.
model Subscription {
  id                 String             @id @db.Char(36)
  organizationId     String             @unique @db.Char(36)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planVersionId      String             @db.Char(36)
  planVersion        PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(TRIAL)
  extraUsers         Int                @default(0)
  currentPeriodStart DateTime           @db.DateTime(3)
  currentPeriodEnd   DateTime           @db.DateTime(3)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)
  items              SubscriptionItem[]
  entitlements       Entitlement[]

  @@unique([organizationId, id])
  @@index([planVersionId])
  @@map("subscription")
}

/// A module inside a subscription, with the price agreed when it was added.
model SubscriptionItem {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptionId String       @db.Char(36)
  subscription   Subscription @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Cascade)
  moduleId       String       @db.VarChar(40)
  monthlyPrice   Decimal      @db.Decimal(12, 2)
  activeFrom     DateTime     @db.DateTime(3)
  /// Null while active; set when the module is removed.
  activeUntil    DateTime?    @db.DateTime(3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([subscriptionId, moduleId])
  @@map("subscription_item")
}

enum EntitlementKind {
  MODULE
  LIMIT
}

/// What a company may use right now: a module, or a limit with its value.
/// The server guard reads only this table (MOD-04/05); it is written from
/// the subscription or by platform staff (MOD-09), never by the customer.
model Entitlement {
  id             String          @id @db.Char(36)
  organizationId String          @db.Char(36)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind           EntitlementKind
  /// Module id, or limit key such as "active_products" or "users".
  key            String          @db.VarChar(40)
  /// Value of a limit; null for modules.
  value          Int?
  validFrom      DateTime        @db.DateTime(3)
  /// Null = no end date.
  validUntil     DateTime?       @db.DateTime(3)
  /// Subscription it comes from; null when granted by platform staff.
  subscriptionId String?         @db.Char(36)
  subscription   Subscription?   @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict)
  createdAt      DateTime        @default(now()) @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, kind, key])
  @@map("entitlement")
}

/// How much of a plan limit a company is using (MOD-07). `taken` counts
/// what exists plus what is reserved (e.g. by an import in progress), so
/// one conditional UPDATE decides whether something fits: two requests for
/// the last place cannot both win.
model QuotaUsage {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Limit key of the entitlement: "active_products", "users".
  key            String       @db.VarChar(40)
  /// In use + reserved.
  taken          Int          @default(0)
  /// Part of `taken` that is only reserved.
  reserved       Int          @default(0)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("quota_usage")
}

// ── Platform staff (MOD-09) ──────────────────────────────────────────────

/// People of our own team who may use the internal console (assign plans
/// and modules to any company). Rows are written only with
/// `npm run staff -- add <correo>` by someone with database access; there
/// is no screen to grant it. MFA is mandatory for them.
model PlatformStaff {
  userId     String    @id @db.Char(36)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  /// Set when access is withdrawn; the row stays as a record.
  disabledAt DateTime? @db.DateTime(3)

  @@map("platform_staff")
}

// ── Product catalog (INV-01) ─────────────────────────────────────────────
// The catalog belongs to the shared core (platform/catalog): Inventario,
// Compras and later Ventas use the same products. Text columns use the
// database's case- and accent-insensitive collation, so "tor-001" and
// "TOR-001" are the same SKU.

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// Grouping chosen by the business: "Tornillería", "Pinturas".
model ProductCategory {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(80)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("product_category")
}

model ProductBrand {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(80)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("product_brand")
}

/// One thing the business keeps in stock. Quantities never live here:
/// stock is the sum of movements (INV-15). An active product takes one
/// place of the plan's quota; an archived one does not.
model Product {
  id             String                @id @db.Char(36)
  organizationId String                @db.Char(36)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Code the business uses for the product; unique in the company.
  sku            String                @db.VarChar(64)
  name           String                @db.VarChar(160)
  description    String?               @db.Text
  categoryId     String?               @db.Char(36)
  category       ProductCategory?      @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  brandId        String?               @db.Char(36)
  brand          ProductBrand?         @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  /// Printed code read by a scanner; unique in the company when present.
  barcode        String?               @db.VarChar(64)
  /// Unit in which the product is controlled (INV-06). Stock is always
  /// kept in this unit; presentations convert to it.
  unitCode       String                @default("piece") @db.VarChar(12)
  unit           Unit                  @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  /// Increment accepted for quantities: 1 = whole units, 0.01 = hundredths.
  quantityStep   Decimal               @default(1) @db.Decimal(12, 3)
  presentations  ProductPresentation[]
  status         ProductStatus         @default(ACTIVE)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  /// List and search (INV-10/11): the order by name and the three searched
  /// columns live in one index, so a search never reads the whole table.
  @@index([organizationId, status, name, sku, barcode])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
  @@map("product")
}

// ── Units of measure (INV-05) ────────────────────────────────────────────

/// Fixed catalog shared by every company, seeded by migration from
/// src/platform/catalog/units.ts (a test keeps both equal). Reference
/// data: it has no company and is never emptied by the test setup.
model Unit {
  code        String    @id @db.VarChar(12)
  /// count, mass, length, volume or area.
  dimension   String    @db.VarChar(12)
  name        String    @db.VarChar(40)
  plural      String    @db.VarChar(40)
  symbol      String    @db.VarChar(8)
  /// Reference units of its dimension in one of this unit.
  toReference Decimal   @db.Decimal(18, 9)
  fractional  Boolean
  products    Product[]

  @@map("unit")
}

// ── Presentations (INV-07, INV-08) ───────────────────────────────────────

/// How a product is bought or handled besides its unit: "Caja", "Rollo",
/// "Saco". Each company defines them per product; the name alone says
/// nothing about the content.
model ProductPresentation {
  id             String                @id @db.Char(36)
  organizationId String                @db.Char(36)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String                @db.Char(36)
  product        Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  name           String                @db.VarChar(40)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  versions       PresentationVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, productId, name])
  @@map("product_presentation")
}

/// Content of a presentation in the product's unit ("100 piezas"), as it
/// was from a moment on. A change of content is a new version; movements
/// keep the version they used, so history never changes (INV-08).
model PresentationVersion {
  id              String              @id @db.Char(36)
  organizationId  String              @db.Char(36)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  presentationId  String              @db.Char(36)
  presentation    ProductPresentation @relation(fields: [organizationId, presentationId], references: [organizationId, id], onDelete: Restrict)
  version         Int
  /// Units of the product in one presentation.
  factor          Decimal             @db.Decimal(18, 3)
  createdByUserId String              @db.Char(36)
  createdAt       DateTime            @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([presentationId, version])
  @@map("presentation_version")
}
