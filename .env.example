# Copia este archivo como .env.local y completa MYSQL_ROOT_PASSWORD.
# `npm run db:setup` agrega el resto (usuarios y contraseñas aleatorias).

# Solo para crear bases y usuarios locales (scripts/db-setup.mjs).
MYSQL_ROOT_PASSWORD=

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=almacen_dev
DATABASE_TEST_NAME=almacen_test
DATABASE_SHADOW_NAME=almacen_shadow

# Aplicación: solo lectura/escritura de datos.
DATABASE_APP_USER=almacen_app
DATABASE_APP_PASSWORD=

# Migraciones (Prisma CLI): cambios de esquema.
DATABASE_MIGRATOR_USER=almacen_migrator
DATABASE_MIGRATOR_PASSWORD=

# Autenticación (Better Auth). `npm run env:setup` genera el secreto.
# En producción es obligatoria y, fuera de localhost, https://.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Proxys delante de la app (ADR 0003): la IP del cliente es la entrada de
# X-Forwarded-For que está este número de lugares desde el final. Default: 1
# TRUSTED_PROXY_HOPS=

# Folder for the private files of companies (uploads, exports). Outside
# anything the web server publishes. Default: ./storage
# FILE_STORAGE_DIR=

# Correo: log (desarrollo, ver /correos) | memory (pruebas) | smtp (producción, ADR 0023).
MAIL_DRIVER=log
# Con MAIL_DRIVER=smtp (Resend, Amazon SES, Brevo, correo del hosting…):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | tls (puerto 465) | none (solo localhost)
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Almacén <avisos@tudominio.mx>
# Avisos de operación (PIL-04): a quién escribe el worker cuando algo falla
# o se recupera. Vacío = solo en el registro.
# ALERT_EMAIL=
# Salud de la app web que consulta el worker. Por defecto http://127.0.0.1:3000/api/salud
# HEALTH_URL=

# Cuenta demo local (npm run db:seed). env:setup genera la contraseña.
DEMO_EMAIL=demo@almacen.test
DEMO_PASSWORD=
# MFA de la cuenta demo (titular): npm run demo:codigo muestra el código.
DEMO_TOTP_SECRET=

# Pago en línea con Stripe (ADR 0028). Vacías = Stripe no se ofrece.
# Las claves de pruebas (sandbox) empiezan con sk_test_; el secreto del
# webhook (whsec_…) sale del endpoint /api/pagos/stripe/webhook en Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
