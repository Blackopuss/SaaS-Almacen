# Copia este archivo como .env.local y completa MYSQL_ROOT_PASSWORD.
# `npm run db:setup` agrega el resto (usuarios y contraseñas aleatorias).

# Solo para crear bases y usuarios locales (scripts/db-setup.mjs).
MYSQL_ROOT_PASSWORD=

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=almacen_dev
DATABASE_TEST_NAME=almacen_test
DATABASE_SHADOW_NAME=almacen_shadow

# Aplicación: solo lectura/escritura de datos.
DATABASE_APP_USER=almacen_app
DATABASE_APP_PASSWORD=

# Migraciones (Prisma CLI): cambios de esquema.
DATABASE_MIGRATOR_USER=almacen_migrator
DATABASE_MIGRATOR_PASSWORD=

# Autenticación (Better Auth). `npm run env:setup` genera el secreto.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Correo: log (desarrollo, ver /correos) | memory (pruebas). Producción requiere proveedor.
# Folder for the private files of companies (uploads, exports). Outside
# anything the web server publishes. Default: ./storage
# FILE_STORAGE_DIR=

MAIL_DRIVER=log

# Cuenta demo local (npm run db:seed). env:setup genera la contraseña.
DEMO_EMAIL=demo@almacen.test
DEMO_PASSWORD=
# MFA de la cuenta demo (titular): npm run demo:codigo muestra el código.
DEMO_TOTP_SECRET=
