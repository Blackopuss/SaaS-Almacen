# Configuración de producción de Almacén (la escribe deploy/instalar.sh en
# /srv/almacen/shared/.env.local). Los secretos se generan solos; lo único
# que falta llenar a mano es el correo (sección «Correo»).
# Nunca subir este archivo a git ni compartirlo.

# Dirección pública (HTTPS, la pone Caddy).
BETTER_AUTH_URL=https://@@DOMINIO@@
# Cifra los secretos de MFA: respaldarlo aparte y NO cambiarlo (ADR 0003).
BETTER_AUTH_SECRET=@@AUTH_SECRET@@
# Caddy es el único proxy delante de la app.
TRUSTED_PROXY_HOPS=1

# MySQL 9.4 en este mismo servidor (solo escucha en 127.0.0.1).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=almacen
DATABASE_APP_USER=almacen_app
DATABASE_APP_PASSWORD=@@APP_PASSWORD@@
DATABASE_MIGRATOR_USER=almacen_migrator
DATABASE_MIGRATOR_PASSWORD=@@MIGRATOR_PASSWORD@@

# Archivos de las empresas, latido del worker y estado del último respaldo.
FILE_STORAGE_DIR=/srv/almacen/shared/storage
WORKER_HEARTBEAT_FILE=/srv/almacen/shared/run/worker-heartbeat.json
BACKUP_STATUS_FILE=/srv/almacen/shared/run/ultimo-respaldo
LOG_FORMAT=json
NEXT_TELEMETRY_DISABLED=1

# Correo (ADR 0023). Llena estos datos con los de tu proveedor (Resend,
# Amazon SES, Brevo…) y prueba con: almacen correo:prueba tu@correo.mx
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Almacén <avisos@@@DOMINIO@@>

# Avisos de operación (PIL-04, ADR 0025): el worker escribe aquí cuando algo
# empieza a fallar (errores, cola detenida, respaldo fallido, base, web) y
# cuando se recupera. Vacío = solo quedan en el registro (journalctl).
ALERT_EMAIL=
