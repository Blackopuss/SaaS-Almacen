# Caddy delante de Almacén (lo escribe deploy/instalar.sh). Pide y renueva
# solo el certificado HTTPS y pasa todo a la app, que escucha en 127.0.0.1.
{
	@@CORREO_LINEA@@
}

@@DOMINIO@@ {
	@@TLS@@
	encode zstd gzip

	# Importaciones de hasta 10 MB más el formulario (next.config.ts).
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/almacen.log {
			roll_size 50MiB
			roll_keep 5
		}
		# No guardar en claro los tokens de recuperación/confirmación que
		# viajan en la URL (y en el Referer): se redactan antes de escribir
		# el registro (auditoría 3). El filtro reemplaza el token por
		# «[redactado]» tanto en la ruta (/api/auth/reset-password/<token>)
		# como en el query (?token=…).
		format filter {
			wrap json
			fields {
				request>uri regexp "reset-password/[^&?/]+|[?&]token=[^&?/]+" "[redactado]"
				request>headers>Referer regexp "reset-password/[^&?/]+|[?&]token=[^&?/]+" "[redactado]"
			}
		}
	}
}
