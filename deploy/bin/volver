#!/usr/bin/env bash
# Regresa a la versión anterior de Almacén (PIL-01), sin tocar la base:
#
#   sudo -u almacen /usr/local/lib/almacen/volver            (la anterior)
#   sudo -u almacen /usr/local/lib/almacen/volver 20261020-…  (una en especial)
#
# Funciona porque las migraciones solo agregan: la versión anterior sigue
# entendiendo la base. Lista de versiones: ls /srv/almacen/releases
set -euo pipefail

BASE=/srv/almacen
falla() { printf '\n\033[1;31mError: %s\033[0m\n' "$*" >&2; exit 1; }
[[ "$(id -un)" == "almacen" ]] || falla "córrelo como almacen: sudo -u almacen $0"

exec 9>"$BASE/shared/run/despliegue.lock"
flock -n 9 || falla "hay un despliegue en curso."

ACTIVA="$(readlink -f "$BASE/current")"
if [[ -n "${1:-}" ]]; then
  [[ "$1" =~ ^[0-9]{8}-[0-9]{6}-[0-9a-f]{7}$ ]] || falla "versión inválida: $1"
  DESTINO="$BASE/releases/$1"
else
  DESTINO="$(find "$BASE/releases" -mindepth 1 -maxdepth 1 -type d | sort |
    awk -v activa="$ACTIVA" '$0 == activa { print previa; exit } { previa = $0 }')"
fi
[[ -n "$DESTINO" && -d "$DESTINO" ]] || falla "no hay una versión anterior a $(basename "$ACTIVA")."
[[ "$DESTINO" != "$ACTIVA" ]] || falla "$(basename "$DESTINO") ya es la activa."

ln -sfn "$DESTINO" "$BASE/current.nuevo"
mv -Tf "$BASE/current.nuevo" "$BASE/current"
sudo /usr/bin/systemctl restart almacen-web.service
sudo /usr/bin/systemctl restart almacen-worker.service

for _ in $(seq 1 45); do
  if curl -sS --max-time 5 http://127.0.0.1:3000/api/salud 2>/dev/null |
    jq -e '.checks.database == "ok"' >/dev/null 2>&1; then
    printf '\033[1;32mActiva:\033[0m %s\n' "$(basename "$DESTINO")"
    exit 0
  fi
  sleep 2
done
falla "$(basename "$DESTINO") no respondió. Revisa: journalctl -u almacen-web -n 100"
